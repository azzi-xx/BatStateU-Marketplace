# Copy this file to ".env" and adjust if needed.
# The app runs fine with the defaults below, so .env is optional for local demos.

PORT=3000
NODE_ENV=development

# Secret used to sign the session cookie. Change this to any random string.
SESSION_SECRET=batstateu-marketplace-dev-secret

# Only emails ending in this domain are allowed to register.
ALLOWED_EMAIL_DOMAIN=g.batstate-u.edu.ph

# Optional: point the database somewhere else. Defaults to database/marketplace.db
# DB_PATH=database/marketplace.db

# ---------------------------------------------------------------------------
# Campus map integration (OpenStreetMap)
# ---------------------------------------------------------------------------
# The map itself is drawn in the browser with Leaflet + OpenStreetMap tiles.
# Coordinates are seeded, so no key is required.
#
# Nominatim (the external geocoding API) asks for a contact address in the
# User-Agent. Put your real email here for the live demo.
MAP_CONTACT=batstateu-marketplace@example.com

# Optional overrides for the provider endpoints (useful if a mirror is needed).
# NOMINATIM_URL=https://nominatim.openstreetmap.org
# MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# If OSM tiles return 403 on your network, the browser switches to this
# OpenStreetMap-based backup automatically.
# MAP_FALLBACK_TILE_URL=https://basemaps.cartocdn.com/light_all/{z}/{x}/{y}.png
# GEOCODER_TIMEOUT_MS=8000
